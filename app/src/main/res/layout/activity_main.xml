<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Core Post-Unlock Interface Container -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Top Internal Pages Switcher Navigation Tabs -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:background="#EEEEEE">

            <Button
                    android:id="@+id/btn_tab_creds"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="App Creds"
                    style="?android:attr/buttonBarButtonStyle"
                    android:textStyle="bold" />

            <Button
                    android:id="@+id/btn_tab_list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="App List"
                    style="?android:attr/buttonBarButtonStyle"
                    android:textStyle="bold" />
        </LinearLayout>

        <!-- PAGE 1 CONTAINER: App Credentials & Security Configuration Dashboard -->
        <ScrollView
                android:id="@+id/container_creds"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:visibility="visible">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/status_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Status: Off"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                    <Button android:id="@+id/start_service_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Start Forwarder" />

                    <Button android:id="@+id/stop_service_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stop Forwarder" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="16dp" android:background="#CCCCCC" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Security Status" android:textStyle="bold" />

                <TextView android:id="@+id/lock_status_text_view"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="App Lock: Inactive" />

                <Button android:id="@+id/btn_enable_app_lock"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Enable App Lock Service" />

                <TextView android:id="@+id/admin_status_text_view"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Uninstall Protection: Inactive" />

                <Button android:id="@+id/btn_enable_device_admin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Activate Admin (Anti-Uninstall)" />

                <TextView android:id="@+id/overlay_status_text_view"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Overlay (Appear on Top): Inactive" />

                <Button android:id="@+id/btn_enable_overlay"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Enable Appear on Top" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="16dp" android:background="#CCCCCC" />

                <TextView
                        android:id="@+id/token_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="Web Token ▲"
                        android:textStyle="bold" />

                <LinearLayout
                        android:id="@+id/token_section_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                    <!-- Inside activity_main.xml, within the token_section_content LinearLayout -->
                    <CheckBox
                            android:id="@+id/cb_forward_work"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Forward Work Profile Notifications"
                            android:checked="true" />

                    <CheckBox
                            android:id="@+id/cb_forward_secure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Forward Secure Folder Notifications"
                            android:checked="true" />

                    <EditText
                            android:id="@+id/web_token_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Web Token Mapping String"
                            android:inputType="textPassword" />

                    <EditText
                            android:id="@+id/delay_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Forwarding Delay (ms)"
                            android:inputType="number" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <Button android:id="@+id/save_button"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Save Token Settings" />

                        <Button android:id="@+id/test_notification"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Test Routing Map" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginVertical="16dp" android:background="#CCCCCC" />

                <!-- Dynamic Dashboard PIN Configuration Block -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Update Security PIN" android:textStyle="bold" />

                <EditText
                        android:id="@+id/edt_new_pin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter New 6-Digit PIN"
                        android:inputType="numberPassword"
                        android:maxLength="6" />

                <Button
                        android:id="@+id/btn_update_pin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Commit New Security PIN" />
            </LinearLayout>
        </ScrollView>

        <!-- PAGE 2 CONTAINER: Transactional Protected App Selection List Panel -->
        <LinearLayout
                android:id="@+id/container_app_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/app_list_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                <Button
                        android:id="@+id/btn_clear_list"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Clear List"
                        android:backgroundTint="#FF4444"
                        android:textColor="#FFFFFF" />

                <Button
                        android:id="@+id/btn_save_list"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:text="Save Changes"
                        android:backgroundTint="#00C851"
                        android:textColor="#FFFFFF" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Master Hardcoded + Custom PIN Full-Screen Screen Overlay Guard -->
    <LinearLayout
            android:id="@+id/pin_overlay_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="visible">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authentication Required"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:textColor="#222222"/>

        <EditText
                android:id="@+id/pin_input_field"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:hint="Enter PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:gravity="center"
                android:textSize="18sp"/>

        <Button
                android:id="@+id/btn_verify_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock Dashboard"
                android:layout_marginTop="20dp"/>
    </LinearLayout>

</FrameLayout>